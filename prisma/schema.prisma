generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum TaskStatus {
  BLOCKED
  IN_PROGRESS
  COMPLETED
}

enum LeaveType {
  SICK
  CASUAL
  VACATION
  OPTIONAL
}

model User {
  id String @id @default(uuid())

  firebaseUid String? @unique

  name  String
  email String   @unique
  role  UserRole @default(EMPLOYEE)

  taskStatus         TaskStatus @default(BLOCKED)
  currentLearning    String?
  learningDetails    String?
  learningStatus     String?
  currentTask        String?
  timesheetUrl       String?
  timesheetUpdatedAt DateTime?
  lastSeenAt         DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  timesheets     Timesheet[]
  activityEvents ActivityEvent[]
  leaves         Leave[]

  @@index([updatedAt])
}

model Timesheet {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart  DateTime
  totalHours Float

  categories Json @default("{}")

  syncedAt DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model ActivityEvent {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  message String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ProjectTask {
  id    String @id @default(uuid())
  title String

  projectName String
  taskStatus  TaskStatus

  assignTask String

  meetingTime    DateTime?
  meetingPurpose String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectName])
  @@index([createdAt])
}

model Leave {
  id         String    @id @default(uuid())

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveType  LeaveType

  fromDate   DateTime
  toDate     DateTime

  reason     String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([fromDate, toDate])
}
